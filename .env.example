# Copy to .env and adjust. Used by docker compose.

POSTGRES_USER=openusenet
POSTGRES_PASSWORD=openusenet
POSTGRES_DB=openusenet

# FQDN used as Path token, Message-ID domain, and (later) ACME name.
OPENUSENET_HOSTNAME=news.localhost
OPENUSENET_ORGANIZATION=OpenUsenetServer
OPENUSENET_LISTEN=:119
OPENUSENET_POSTGRES=postgres://openusenet:openusenet@postgres:5432/openusenet?sslmode=disable
OPENUSENET_MBOX_DIR=/var/spool/openusenet/archive
