# Copy to .env and adjust. Used by docker compose.

# OPENUSENET_IMAGE=jsevans/openusenet:latest

POSTGRES_USER=openusenet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=openusenet

# FQDN used as Path token and Message-ID domain. Must match what peers list for you.
OPENUSENET_HOSTNAME=news.example.org
OPENUSENET_ORGANIZATION=OpenUsenetServer
OPENUSENET_LISTEN=:119
OPENUSENET_HTTP=:8080

# Admin HTTPS via Caddy (docs/tls.md). Same name as OPENUSENET_HOSTNAME is typical.
ADMIN_DOMAIN=news.example.org
ACME_EMAIL=you@example.org

# First admin (optional). Prefer changing this after first login.
# OPENUSENET_BOOTSTRAP_ADMIN=admin:changeme

# Live peering: leave require_peer_auth off unless both sides agree on passwords.
# Prefer open=false + peer hostnames in the admin UI (classic INN model).
# OPENUSENET_INBOUND_OPEN=false
# OPENUSENET_INBOUND_ALLOW=
# OPENUSENET_REQUIRE_PEER_AUTH=false

# NNTPS later (not enabled in compose yet):
# OPENUSENET_NNTP_TLS=:563
# OPENUSENET_TLS_CERT=/certs/fullchain.pem
# OPENUSENET_TLS_KEY=/certs/privkey.pem

OPENUSENET_POSTGRES=postgres://openusenet:changeme@postgres:5432/openusenet?sslmode=disable
OPENUSENET_MBOX_DIR=/var/spool/openusenet/archive
OPENUSENET_EXPORT_DIR=/var/spool/openusenet/exports
OPENUSENET_CLEANFEED=true
OPENUSENET_CLEANFEED_MODE=reject
